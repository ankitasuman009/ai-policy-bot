# Default: use the native local Ollama integration.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
LLM_TEMPERATURE=0

# To use ChatOpenAI with local Ollama instead, set:
# LLM_PROVIDER=openai-compatible
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama

# To use a hosted OpenAI-compatible API, set its base URL, model name, and
# API key in your private .env file. Never commit that key.
